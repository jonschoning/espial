{
  "name": "espial",
  "private": true,
  "scripts": {
    "make-install": "make install",
    "typecheck": "tsc -p tsconfig.json",
    "bundle:prep": "shx rm -f dist/app.js dist/app.min.js dist/app.min.js.map dist/app-*.min.js dist/app-*.min.js.map dist/app-*.min.js.gz dist/app-*.min.js.map.gz",
    "bundle:build": "node scripts/build-bundle.mjs",
    "bundle:publish": "node ./scripts/publish-bundle.mjs",
    "bundle:report": "node ./scripts/report-dist.mjs",
    "bundle": "npm run bundle:prep && npm run bundle:build && npm run bundle:publish && npm run bundle:report",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,json,md}\""
  },
  "devDependencies": {
    "@babel/core": "^8.1.2",
    "@babel/preset-react": "^8.0.1",
    "@babel/preset-typescript": "^8.0.7",
    "@eslint/js": "^10.0.1",
    "@types/dompurify": "^3.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.72.2",
    "@typescript-eslint/parser": "^8.72.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "cross-env": "^10.1.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-check-file": "^3.3.2",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-testing-library": "^7.16.2",
    "prettier": "^3.10.0",
    "shx": "^0.4.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2"
  },
  "dependencies": {
    "dompurify": "^3.4.17",
    "highlight.js": "^11.12.0",
    "i18next": "^27.1.1",
    "i18next-chained-backend": "^5.0.8",
    "i18next-http-backend": "^4.0.10",
    "i18next-localstorage-backend": "^4.3.3",
    "ky": "^2.2.0",
    "marked": "^18.2.0",
    "marked-highlight": "^2.2.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^18.0.1",
    "zustand": "^5.1.0"
  },
  "overrides": {
    "eslint-plugin-import": {
      "eslint": "$eslint"
    }
  }
}
